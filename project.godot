; Engine configuration file.
config_version=5

[application]

config/name="gs-script"
config/description="Sandboxed, data-driven scripting for community servers: triggers, conditions and a whitelist of actions in a document, with a per-tick cost budget and no arbitrary code."
run/main_scene="res://examples/script_selftest.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[editor_plugins]

enabled=PackedStringArray("res://addons/gs_script/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
